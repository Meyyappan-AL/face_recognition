# Copy to .env and fill real values. Never commit .env.

# Flask / storage
FLASK_SECRET_KEY=change-me
# ERP_DB_PATH=C:\path\to\attendance.db

# Background workers (1 = enabled, 0 = disable)
ERP_NOTIFY_WORKER=1
ERP_ABSENCE_WORKER=1

# Local face attendance
# FACE_DETECTOR_MODEL=C:\path\to\face_detection_yunet_2023mar.onnx
ERP_FACE_VIDEO_MAX_MB=550
ERP_FACE_WEBCAM_MAX_MB=10
ERP_FACE_SAMPLE_FPS=2
ERP_FACE_VIDEO_MAX_SECONDS=3600
ERP_FACE_VIDEO_MAX_FACES=80
ERP_FACE_UNKNOWN_MAX_GROUPS=300
ERP_FACE_MIN_CONFIDENCE=0.55
ERP_FACE_REVIEW_CONFIDENCE=0.72
ERP_FACE_UNKNOWN_SIMILARITY=0.92
ERP_FACE_JOB_VIDEO_TTL_HOURS=24

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_SSL=0
SMTP_TLS=1

# SMS (Fast2SMS)
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
